    },
    {
      "label": "Month income in €",
      "type": "textfield",
      "layout": {
        "row": "Row_1ucmt34",
        "columns": null
      },
      "id": "Field_0p5ekdd",
      "key": "formMonthIncome",
      "appearance": {
        "suffixAdorner": "€"
      },
      "validate": {
        "required": false
      },
      "readonly": true,
      "conditional": {
        "hide": "=formCheckboxHasStartingCreditValue = false"
      }
    },
    {
