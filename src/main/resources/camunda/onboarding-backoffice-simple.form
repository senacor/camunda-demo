      "validate": {
        "required": true
      },
      "properties": {}
    },
    {
      "label": "Has starting credit?",
      "type": "checkbox",
      "layout": {
        "row": "Row_0muyo3f",
        "columns": null
      },
      "id": "Field_1byp5c6",
      "key": "formCheckboxHasStartingCreditValue",
      "validate": {
        "required": false
      },
