      }
    },
    {
      "label": "Details",
      "type": "textarea",
      "layout": {
        "row": "Row_049o5pw",
        "columns": null
      },
      "id": "Field_0jshn33",
      "key": "formDetails",
      "conditional": {
        "hide": "=formStatus = null or formStatus = \"SUCCESS\""
      }
    }
  ],
