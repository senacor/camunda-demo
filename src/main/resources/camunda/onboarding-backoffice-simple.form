        "columns": null
      },
      "id": "Field_0bedzr4",
      "key": "formStartingCreditValue",
      "validate": {
        "required": false,
        "min": 0
      },
      "appearance": {
        "suffixAdorner": "€"
      },
      "conditional": {
        "hide": "=formCheckboxHasStartingCreditValue = false"
      }
    },
    {
      "values": [
        {
          "label": "SUCCESS",
          "value": "SUCCESS"
        },
        {
          "label": "FAILED",
          "value": "FAILED"
        }
